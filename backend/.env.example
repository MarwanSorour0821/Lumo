# Django Settings
SECRET_KEY=your-django-secret-key
DEBUG=False

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_PROJECT_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Subscription Price IDs
STRIPE_MONTHLY_PRICE_ID=price_xxx
STRIPE_YEARLY_PRICE_ID=price_xxx

# Stripe Credit Bundle Price IDs
# Create these products/prices in Stripe Dashboard:
# - 1 Credit: $1.99 (one-time payment)
# - 3 Credits: $3.99 (one-time payment) 
# - 5 Credits: $5.99 (one-time payment)
STRIPE_CREDIT_1_PRICE_ID=price_xxx
STRIPE_CREDIT_3_PRICE_ID=price_xxx
STRIPE_CREDIT_5_PRICE_ID=price_xxx

# AWS Configuration (for Textract)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
